{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faultlinebrief-website-d1-isolated",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "routes": [],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "faultlinebrief-d1-production",
      "database_id": "cc4cf967-6c3a-4c7d-a5a1-ca3cd9f2d8a9",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "FAULTLINE_D1_READS": "true",
    "FAULTLINE_D1_API_URL": "https://faultlinebrief-public-d1-preview.zakria25.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "faultlinebriefq-media"
    }
  ]
}
